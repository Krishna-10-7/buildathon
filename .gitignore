# secrets & local state
.env
*.env
*.db
*.db-wal
*.db-shm
*.prestemo.*

# rotation backups from scripts/rotate_keys.sh — named .env.rotate-bak.<pid>,
# so `*.env` does NOT match them. They hold live key material and must never
# be committed. (Root cause of the naming: the suffix is what makes the
# backup unique per run; the ignore rule is the safety net for it.)
.env.rotate-bak.*
**/.env.rotate-bak.*

# scratch dir used by local tooling (probes, JS syntax checks, dumps)
.tmp/

# python
__pycache__/
.venv/
.pytest_cache/
*.egg-info/

# logs & build artifacts
*.log
*.tgz
*.err

# browser automation state (persona profiles: HTTP/GPU/shader cache,
# crash metrics, cookies — regenerated locally, never needed in the repo)
app/artifacts/profiles/
**/BrowserMetrics*.pma
**/CrashpadMetrics*.pma
**/GrShaderCache/
**/GPUCache/
**/ShaderCache/
**/Code Cache/
**/Cache/Cache_Data/
**/.org.chromium.*
**/Singleton*
**/Cookies*
**/Login Data*
**/Web Data*

# persona contact details used for checkout (synthetic, but not for public)
app/artifacts/persona_identities.json

# experiments output (large raw logs stay out of git; metrics summaries go in)
experiments/results/

# upstream ChatDev sprite PNGs (14 MB). Re-fetchable with
#   python app/scripts/fetch_chatdev_sprites.py
# only the derived app/assets/chatdev_sheet.{png,js} is committed.
app/assets/chatdev_src/
