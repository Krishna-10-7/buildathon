# Bazaar — example environment. Copy to .env and fill in.
# No real values here. .env is gitignored at the repo root.
#
# IMPORTANT: this project runs ENTIRELY on Razorpay TEST mode.
# Never put live keys in this file. Rehearsal ids are prefixed
# ord_REHEARSAL... and can never masquerade as captured payments.

# ---------------------------------------------------------------- runtime
ENV=dev

# DB_PATH intentionally unset: defaults to <app dir>/bazaar.db on every
# machine, so the same bundle runs on the laptop, VM1 and VM2 unchanged.
# DB_PATH=/absolute/path/to/bazaar.db

# -------------------------------------------------------------- razorpay
# Dashboard -> Settings -> API Keys. TEST MODE ONLY.
RZP_KEY_ID=
RZP_KEY_SECRET=

# Dashboard -> Settings -> Webhooks -> your endpoint -> signing secret.
# Verified with HMAC-SHA256 over the RAW body before any state changes.
RZP_WEBHOOK_SECRET=

# ------------------------------------------------------------------- llm
# mock | gemini | nvidia | openrouter
# `mock` runs the entire pipeline (including the growth agent and the
# buyer personas) with NO keys at all — useful for judges and CI.
LLM_PROVIDER=mock

GEMINI_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=

# -------------------------------------------------------------- mandates
# HMAC key for buyer spend envelopes. PIN THIS: rotating it invalidates
# every outstanding mandate signature, so generate it once and keep it.
#   python -c "import secrets; print(secrets.token_hex(32))"
MANDATE_SECRET=

# ------------------------------------------------------------ experiment
# Token for POST /experiment/arm, minted on the merchant host:
#   python scripts/experiment_token.py
# Every arm flip is written to the audit ledger.
EXP_TOKEN=

# ---------------------------------------------------------------- public
# Used for the MCP DNS-rebinding host allowlist and callback URLs.
PUBLIC_BASE_URL=http://localhost:8000
